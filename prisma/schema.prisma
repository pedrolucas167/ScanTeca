generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum BookStatus {
  READ
  READING
  TO_READ
  WISHLIST
}

enum DiaryEntryType {
  REFLECTION
  QUOTE
  OCR
}

enum RecommendationFeedbackKind {
  WANT
  DISMISSED
}

model Book {
  id            String     @id @default(cuid())
  isbn          String
  title         String
  author        String
  publishedDate String?
  synopsis      String?
  coverUrl      String?
  status        BookStatus @default(TO_READ)
  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  notes         String?
  rating        Int?
  genre         String?
  pages         Int?
  currentPage   Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  customOrder   Int?
  embedding     Unsupported("vector(1536)")?
  userId        String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reviews       Review[]
  readingSessions ReadingSession[]
  diaryEntries    DiaryEntry[]

  @@unique([isbn, userId])
  @@index([userId])
  @@index([status])
  @@index([collectionId])
  @@index([genre])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  books     Book[]

  @@unique([userId, name])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  content   String
  rating    Int?
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  userName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([userId])
}

model LibrarySetting {
  id            String  @id @default(cuid())
  userId        String  @unique
  name          String  @default("Minha Biblioteca")
  shareId       String? @unique
  shareEnabled  Boolean @default(false)
  oracleProfile String?
  yearlyGoal    Int?
  accentTheme   String?
}

model ReadingLog {
  id        String   @id @default(cuid())
  userId    String
  bookId    String?
  date      DateTime @db.Date
  pages     Int
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model ReadingSession {
  id          String       @id @default(cuid())
  userId      String
  bookId      String
  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  startedPage Int
  currentPage Int
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  durationSec Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  entries     DiaryEntry[]

  @@index([userId, startedAt])
  @@index([bookId, startedAt])
}

model DiaryEntry {
  id         String          @id @default(cuid())
  userId     String
  bookId     String
  book       Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    ReadingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type       DiaryEntryType  @default(REFLECTION)
  content    String
  page       Int?
  tags       String[]        @default([])
  ragEnabled Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([bookId, createdAt])
  @@index([sessionId])
}

model OracleMessage {
  id        String         @id @default(cuid())
  userId    String
  role      String
  content   String
  sources   Json?
  sessionId String?
  session   OracleSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([sessionId])
}

model OracleSession {
  id        String          @id @default(cuid())
  userId    String
  title     String
  mode      String          @default("EXPLORE")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  OracleMessage[]
  artifacts OracleArtifact[]

  @@index([userId, updatedAt])
}

model OracleArtifact {
  id        String         @id @default(cuid())
  userId    String
  sessionId String?
  session   OracleSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type      String
  title     String
  content   String
  sources   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, updatedAt])
  @@index([sessionId])
}

model RecommendationFeedback {
  id               String                    @id @default(cuid())
  userId           String
  title            String
  author           String
  normalizedTitle  String
  normalizedAuthor String
  kind             RecommendationFeedbackKind
  source           String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([userId, normalizedTitle, normalizedAuthor])
  @@index([userId])
  @@index([userId, kind])
}

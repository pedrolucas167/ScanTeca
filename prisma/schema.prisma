generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id              String   @id @default(cuid())
  isbn            String   @unique
  title           String
  author          String
  publishedDate   String?
  synopsis        String?
  coverUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

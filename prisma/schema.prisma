generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum BookStatus {
  READ
  READING
  TO_READ
  WISHLIST
}

model Book {
  id            String     @id @default(cuid())
  isbn          String
  title         String
  author        String
  publishedDate String?
  synopsis      String?
  coverUrl      String?
  status        BookStatus @default(TO_READ)
  collection    String     @default("Minha Biblioteca")
  notes         String?
  rating        Int?
  genre         String?
  pages         Int?
  currentPage   Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  customOrder   Int?
  embedding     Unsupported("vector(1536)")?
  userId        String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reviews       Review[]

  @@unique([isbn, userId])
  @@index([userId])
  @@index([status])
  @@index([collection])
  @@index([genre])
}

model Review {
  id        String   @id @default(cuid())
  content   String
  rating    Int?
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  userName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([userId])
}

model LibrarySetting {
  id            String  @id @default(cuid())
  userId        String  @unique
  name          String  @default("Minha Biblioteca")
  shareId       String? @unique
  shareEnabled  Boolean @default(false)
  oracleProfile String?
  yearlyGoal    Int?
  accentTheme   String?
}

model ReadingLog {
  id        String   @id @default(cuid())
  userId    String
  bookId    String?
  date      DateTime @db.Date
  pages     Int
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model OracleMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  sources   Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

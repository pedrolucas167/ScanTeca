{
  "name": "scanteca",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "eval:oracle": "tsx scripts/evaluate-oracle.ts",
    "eval:oracle:free": "node scripts/run-oracle-free-benchmark.mjs",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:report": "node scripts/coverage-report.mjs",
    "coverage:check": "node scripts/coverage-report.mjs --check",
    "test:coverage-tools": "node --test scripts/coverage-policy.test.mjs",
    "test:ci-policy": "node --test scripts/github-policy.test.mjs",
    "ci:policy": "node scripts/check-github-policy.mjs",
    "security:audit": "node scripts/dependency-audit.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "secrets:staged": "node scripts/secret-scan.mjs --staged",
    "secrets:hooks": "node scripts/install-secret-hooks.mjs",
    "test:secrets": "node --test scripts/secret-scan.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:auth": "node scripts/run-authenticated-e2e.mjs",
    "test:e2e-tools": "node --test scripts/redact-test-log.test.mjs scripts/e2e-clerk-keys.test.mjs scripts/e2e-provider-fixtures.test.mjs",
    "test:db-tools": "node --test scripts/prepare-test-database.test.mjs",
    "test:migrations-tools": "node --test scripts/migration-history.test.mjs",
    "migrations:check": "node scripts/check-migration-history.mjs",
    "migrations:test-sql": "node scripts/check-migration-sql.mjs",
    "migrations:verify": "node scripts/run-migration-check.mjs",
    "test:migrations:integration": "node --test scripts/migration-sql.integration.test.mjs",
    "test:container": "node scripts/test-container.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:prepare:test": "node scripts/prepare-test-database.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-development.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@clerk/localizations": "^4.24.4",
    "@clerk/nextjs": "^7.9.23",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@upstash/redis": "^1.40.0",
    "@vercel/otel": "^2.2.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "^3.6.7",
    "yet-another-react-lightbox": "^3.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "3.26.5",
    "@clerk/testing": "2.2.53",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "js-yaml": "4.3.2",
    "jsdom": "30.1.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}

{
  "name": "scanteca",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:report": "node scripts/coverage-report.mjs",
    "coverage:check": "node scripts/coverage-report.mjs --check",
    "test:coverage-tools": "node --test scripts/coverage-policy.test.mjs",
    "test:ci-policy": "node --test scripts/github-policy.test.mjs",
    "ci:policy": "node scripts/check-github-policy.mjs",
    "security:audit": "node scripts/dependency-audit.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e-tools": "node --test scripts/redact-test-log.test.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-development.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@clerk/localizations": "^4.24.0",
    "@clerk/nextjs": "^7.9.1",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.38.4",
    "@vercel/otel": "^2.1.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.41.0",
    "motion": "^14.0.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.51",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "3.2.7",
    "dotenv": "17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}

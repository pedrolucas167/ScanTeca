# Copy this file to `.env` and fill in the real values.
# Everything listed here is required in production unless marked optional.

# --- Database (Neon Postgres) ---
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection used by prisma migrate.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# --- Clerk (auth) ---
# Dashboard: https://dashboard.clerk.com -> your app -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
# Admin access: set {"role": "admin"} in the user's publicMetadata
# (Clerk Dashboard -> Users -> user -> Metadata -> Public).

# --- Web Push (VAPID) ---
# Generate once with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_ is inlined in the client bundle; the private key stays server-only.
# Missing these makes /api/admin/broadcast return 503.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:contato@scanteca.app"

# --- External APIs ---
# Google Books (optional but recommended — better search coverage).
GOOGLE_BOOKS_API_KEY="..."
# OpenRouter — powers the Oracle chat, TTS and embeddings.
OPENROUTER_API_KEY="..."

# --- Cron (required in production) ---
# Vercel sends this as Bearer token when calling /api/cron/* routes.
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=...

# --- Error reporting (optional) ---
# Discord/Slack incoming webhook — receives API error alerts.
# Without it, reportError() is a no-op.
# ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Rate limiting (optional) ---
# If set, rate limit state is shared across serverless instances via Upstash Redis / Vercel KV.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
